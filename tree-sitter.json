{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mybatis",
      "camelcase": "Mybatis",
      "title": "MyBatis",
      "scope": "source.mybatis",
      "file-types": [
        "mybatis"
      ],
      "injection-regex": "^mybatis$",
      "highlights": "queries/mybatis/highlights.scm",
      "class-name": "TreeSitterMybatis"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for MyBatis and iBATIS mapper files",
    "authors": [
      {
        "name": "ishianecho",
        "email": "ishio.liu@outlook.com",
        "url": "https://github.com/ishianecho"
      }
    ],
    "links": {
      "repository": "https://github.com/ishianecho/tree-sitter-mybatis"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
